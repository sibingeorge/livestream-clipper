# Copy to .env (git-ignored). Never commit real values.

# --- Email delivery (required for the daemon to send you clips) ---
# iCloud:  SMTP_HOST=smtp.mail.me.com  SMTP_PORT=587  SMTP_USER=<your Apple ID email>
#          SMTP_PASSWORD=<app-specific password from https://account.apple.com -> Sign-In and Security>
# Gmail:   SMTP_HOST=smtp.gmail.com    SMTP_PORT=587  (app password; requires 2-step verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# --- Optional: Twitch discovery via Helix (free developer app) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
