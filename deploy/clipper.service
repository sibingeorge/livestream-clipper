# Linux without Docker: copy to /etc/systemd/system/clipper.service, adjust paths/user, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now clipper
[Unit]
Description=livestream-clipper daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clipper
WorkingDirectory=/opt/livestream-clipper
ExecStart=/opt/livestream-clipper/.venv/bin/clipper daemon
Restart=always
RestartSec=15
Nice=10

[Install]
WantedBy=multi-user.target
